NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-preview-anon-key
# SUPABASE_SERVICE_ROLE_KEY is server-only and optional for ordinary user-session paths.
# AUTH_TEST_MODE must never be true in Production.
AUTH_TEST_MODE=false
AUTH_GOOGLE_ENABLED=true
AUTH_KAKAO_ENABLED=true
AUTH_NAVER_ENABLED=false
