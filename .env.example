# ── 공통(필수) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# 서버 전용. 로그인·가입·문자 인증 서버 작업에 씁니다. 화면 코드에 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 주소·로그인 유지 ───────────────────────────────────
# 운영: https://zipsin.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 운영: .zipsin.net (집신과 집신체크가 같은 로그인을 씁니다). 로컬은 비워 둡니다.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# 운영: https://ck.zipsin.net (비우면 집신체크를 zipsin.net/ck 로 엽니다)
NEXT_PUBLIC_CHECK_SITE_URL=

# 회원가입·집신체크→집신 저장을 여는 스위치. 비우거나 false면 '준비 중'(2026-10-17 결정).
NEXT_PUBLIC_ACCOUNT_OPEN=false

# ── 로그인 ────────────────────────────────────────────
# 운영은 반드시 true. 없으면 모든 로그인이 '잠시 사용할 수 없음'으로 끝납니다.
PASSWORD_LOGIN_ENABLED=true
# 아직 연결하지 않은 소셜 로그인은 false로 둡니다.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=false
NEXT_PUBLIC_AUTH_NAVER_ENABLED=false
# 32자 이상 임의 문자열. 비우면 서버 키에서 따로 만들어 씁니다.
AUTH_RATE_LIMIT_HMAC_SECRET=generate-a-random-secret-with-at-least-32-characters

# ── 가입 문자 인증 ─────────────────────────────────────
# 운영은 반드시 solapi. disabled면 문자를 보내지 않고 가입이 막힙니다.
PHONE_VERIFICATION_PROVIDER=disabled
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
PHONE_OTP_HMAC_SECRET=generate-a-different-random-secret-with-at-least-32-characters

# ── 대화 ──────────────────────────────────────────────
# false로 두면 실시간 대신 새로고침으로 대화를 불러옵니다.
NEXT_PUBLIC_PILOT_CHAT_REALTIME_ENABLED=true
